{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["br", "details", "summary", "sub", "sup", "kbd", "abbr"] },
    "MD041": false,
    "MD046": { "style": "fenced" }
  },
  "globs": ["**/*.md", "**/*.mdx"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/CHANGELOG.md",
    "**/LICENSE.md"
  ],
  "gitignore": true
}
