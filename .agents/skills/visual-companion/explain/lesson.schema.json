{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
      "description": "The conclusion, shown first"
    },
    "inputs": {
      "default": [],
      "description": "Values the reader can change; formulas see them by key",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
          },
          "value": {
            "type": "number",
            "description": "Starting value"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "description": "mathjs unit, such as km or MB/s; the input enters formulas with this unit",
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "min",
          "max",
          "step"
        ]
      }
    },
    "functions": {
      "default": [],
      "description": "mathjs function definitions shared by every step, such as backoff(n) = min(30 s, 0.5 s * 2^n)",
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
          },
          {
            "pattern": "^\\s*[A-Za-z_]\\w*\\s*\\([^)]*\\)\\s*="
          }
        ]
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
          },
          "blocks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "simple": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                      "description": "Everyday explanation for a newcomer"
                    },
                    "expert": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                      "description": "Precise explanation in the domain's terms"
                    },
                    "tex": {
                      "description": "Optional formula in TeX, shown under the expert text",
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                    },
                    "type": {
                      "type": "string",
                      "const": "Concept"
                    }
                  },
                  "required": [
                    "simple",
                    "expert",
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "presets": {
                      "default": [],
                      "description": "What-if buttons; each sets some inputs, the rest keep their starting values",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "icon": {
                            "type": "string",
                            "enum": [
                              "wear",
                              "ruler",
                              "gauge",
                              "zap",
                              "wrench",
                              "activity",
                              "trending-up",
                              "trending-down"
                            ]
                          },
                          "set": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                            },
                            "additionalProperties": {
                              "type": "number"
                            }
                          }
                        },
                        "required": [
                          "label",
                          "icon",
                          "set"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "const": "Playground"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "steps": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                            "description": "Name later steps use to reference this result"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "plain": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                            "description": "One plain-language line saying what the step means"
                          },
                          "ref": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                            "description": "Code reference this step implements, such as retry.py:42"
                          },
                          "expr": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                            "description": "mathjs expression over inputs, functions and earlier step ids"
                          },
                          "tex": {
                            "description": "Display formula in TeX; defaults to the expression",
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "substitute": {
                            "description": "Readable Substitute line with {name} placeholders; replaces the generated one",
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "unit": {
                            "description": "Unit to show the result in; required when the result carries a unit",
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "expect": {
                            "description": "The value the real code produced at the starting inputs, in the step's unit; publishing fails if the formula disagrees",
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "plain",
                          "ref",
                          "expr"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "const": "Derivation"
                    }
                  },
                  "required": [
                    "steps",
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "question": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                    },
                    "options": {
                      "minItems": 2,
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                      }
                    },
                    "answer": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Index of the correct option, counting from 0"
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                      "description": "Reason shown after the reader picks"
                    },
                    "type": {
                      "type": "string",
                      "const": "Quiz"
                    }
                  },
                  "required": [
                    "question",
                    "options",
                    "answer",
                    "why",
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "claim": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "source": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                            "description": "Where the value comes from: path:line, a commit, a command and its output"
                          },
                          "inferred": {
                            "default": false,
                            "description": "True when the claim was concluded rather than read from the source",
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "claim",
                          "value",
                          "source"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "const": "Evidence"
                    }
                  },
                  "required": [
                    "rows",
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "before": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                      "description": "Column heading for the old side, such as v11"
                    },
                    "after": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                      "description": "Column heading for the new side"
                    },
                    "rows": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "before": {
                            "type": "string",
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "after": {
                            "type": "string",
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          }
                        },
                        "required": [
                          "label",
                          "before",
                          "after"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "const": "Compare"
                    }
                  },
                  "required": [
                    "before",
                    "after",
                    "rows",
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                    },
                    "bars": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
                          },
                          "value": {
                            "type": "number"
                          },
                          "tone": {
                            "default": "neutral",
                            "description": "good and bad color the bar; meaning stays in the label",
                            "type": "string",
                            "enum": [
                              "neutral",
                              "good",
                              "bad"
                            ]
                          }
                        },
                        "required": [
                          "label",
                          "value"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "const": "Chart"
                    }
                  },
                  "required": [
                    "bars",
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "blocks"
        ]
      }
    }
  },
  "required": [
    "title",
    "answer",
    "sections"
  ]
}
