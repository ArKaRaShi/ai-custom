{
  "name": "ai-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "fix": "biome check --write .",
    "test": "bun test"
  },
  "dependencies": {
    "ignore": "^7.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
